# Secret key (S...) of the funded Stellar account that pays every
# fee-bump's network fee. REQUIRED — the service refuses to start without
# a valid one. Never commit a real secret key to version control.
SPONSOR_SECRET_KEY=

# Deployed Stellar Nebula Nomad contract ID (C...). REQUIRED.
CONTRACT_ID=

# Soroban RPC endpoint.
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Must match the network the contract above is deployed on.
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

PORT=3001

# Per-operation base fee (stroops) for the fee-bump envelope.
FEE_BUMP_BASE_FEE=100

# Service-layer rate limits (defense in depth alongside on-chain caps).
IP_RATE_LIMIT_MAX=20
IP_RATE_LIMIT_WINDOW_MS=60000
ADDRESS_RATE_LIMIT_MAX=5
ADDRESS_RATE_LIMIT_WINDOW_MS=60000
